import numpy as np
student_scores = np.array([
    [80, 75, 90, 70],
    [85, 80, 85, 75],
    [90, 85, 80, 80],
    [75, 90, 95, 85]
])
subjects = ["Math", "Science", "English", "History"]
avg = np.mean(student_scores, axis=0)
print("Average scores:", avg)
print("Highest average:", np.max(avg))
print("Subject:", subjects[np.argmax(avg)])
